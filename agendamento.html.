
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Agendar atendimento | Dr. Roque Campos</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}
body{margin:0;background:#171717;color:#eee;font-family:Arial,sans-serif;padding:25px 15px}
main{max-width:520px;margin:35px auto;background:#222;padding:28px;border:1px solid #9c8049;border-radius:12px}
h1{color:#c9aa68;text-align:center;font-size:25px}
p{text-align:center;color:#ccc;line-height:1.5}
label{display:block;margin:18px 0 7px;color:#d4bd8b}
input,select{width:100%;padding:14px;background:#171717;color:white;border:1px solid #655638;border-radius:6px;font-size:16px}
button{width:100%;padding:15px;margin-top:24px;background:#b99a5b;color:#171717;border:0;border-radius:6px;font-weight:bold;font-size:16px}
button:disabled{opacity:.5}
#mensagem{text-align:center;margin-top:18px;color:#e5c77e}
small{display:block;color:#aaa;text-align:center;margin-top:18px;line-height:1.5}
</style>
</head>
<body>
<main>
<h1>Dr. Roque Campos</h1>
<p>Agendamento de atendimento</p>

<form id="form">
<label for="nome">Seu nome completo</label>
<input id="nome" type="text" maxlength="100" required minlength="2" placeholder="Digite seu nome">

<label for="data">Escolha a data</label>
<input id="data" type="date" required>

<label for="horario">Horários disponíveis</label>
<select id="horario" required>
<option value="">Selecione primeiro uma data</option>
</select>

<button id="botao" type="submit">Continuar pelo WhatsApp</button>
</form>

<div id="mensagem"></div>
<small>O pedido será registrado como pendente. A confirmação será feita pelo escritório.</small>
</main>

<script>
const SUPABASE_URL = "https://lnavvnmuqlhetnovwyxr.supabase.co";
const SUPABASE_KEY = "sb_publishable_ncPMZ-VLgvvt7djIA0tb-Q_r_3A6Isz";
const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

const telefone = "5579991379843";
const dataInput = document.getElementById("data");
const horarioInput = document.getElementById("horario");
const mensagem = document.getElementById("mensagem");
const botao = document.getElementById("botao");

function dataLocal(){
  const agora = new Date();
  const ano = agora.getFullYear();
  const mes = String(agora.getMonth()+1).padStart(2,"0");
  const dia = String(agora.getDate()).padStart(2,"0");
  return `${ano}-${mes}-${dia}`;
}

dataInput.min = dataLocal();

async function carregarHorarios(){
  const data = dataInput.value;
  horarioInput.innerHTML = "";

  if(!data) return;

  const diaSemana = new Date(data + "T12:00:00").getDay();

  if(diaSemana === 0 || diaSemana === 6){
    horarioInput.innerHTML = '<option value="">A agenda funciona de segunda a sexta</option>';
    return;
  }

  horarioInput.innerHTML = '<option value="">Carregando horários...</option>';

  const {data:ocupados,error} = await supabase.rpc("get_booked_slots",{
    p_start:data,
    p_end:data
  });

  if(error){
    horarioInput.innerHTML = '<option value="">Erro ao consultar horários</option>';
    mensagem.textContent = "Não foi possível consultar a agenda. Tente novamente.";
    return;
  }

  const horarios = ["08:00","09:30","14:00","15:30"];
  const ocupadosSet = new Set(
    (ocupados || []).map(item => String(item.appointment_time).slice(0,5))
  );

  const agora = new Date();

  horarios.forEach(hora=>{
    const [h,m] = hora.split(":").map(Number);
    const horarioData = new Date(data + "T00:00:00");
    horarioData.setHours(h,m,0,0);

    const opcao = document.createElement("option");
    opcao.value = hora;

    if(ocupadosSet.has(hora)){
      opcao.textContent = hora + " — indisponível";
      opcao.disabled = true;
    }else if(horarioData <= agora){
      opcao.textContent = hora + " — horário passado";
      opcao.disabled = true;
    }else{
      opcao.textContent = hora;
    }

    horarioInput.appendChild(opcao);
  });

  if(!horarioInput.querySelector('option:not(:disabled)')){
    horarioInput.innerHTML = '<option value="">Não há horários disponíveis</option>';
  }

  mensagem.textContent = "";
}

dataInput.addEventListener("change",carregarHorarios);

document.getElementById("form").addEventListener("submit",async(event)=>{
  event.preventDefault();

  const nome = document.getElementById("nome").value.trim();
  const data = dataInput.value;
  const horario = horarioInput.value;

  if(!nome || !data || !horario){
    mensagem.textContent = "Preencha todos os campos.";
    return;
  }

  botao.disabled = true;
  botao.textContent = "Registrando agendamento...";
  mensagem.textContent = "";

  const {error} = await supabase.rpc("book_appointment",{
    p_name:nome,
    p_date:data,
    p_time:horario
  });

  if(error){
    mensagem.textContent = error.message || "Não foi possível registrar. Escolha outro horário.";
    botao.disabled = false;
    botao.textContent = "Continuar pelo WhatsApp";
    await carregarHorarios();
    return;
  }

  const [ano,mes,dia] = data.split("-");
  const dataFormatada = `${dia}/${mes}/${ano}`;

  const texto = `Olá, Dr. Roque! Meu nome é ${nome}. Solicitei um agendamento para ${dataFormatada}, às ${horario}. Gostaria de conversar sobre um atendimento. Aguardo a confirmação.`;

  window.location.href = `https://wa.me/${telefone}?text=${encodeURIComponent(texto)}`;
});
</script>
</body>
</html>
